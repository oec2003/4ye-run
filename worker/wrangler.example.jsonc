{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4ye-run-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4ye-run-production",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "4ye-run-assets-production"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "4001",
      "simple": { "limit": 3000, "period": 60 }
    }
  ],
  "vars": {
    "ASSET_PUBLIC_BASE_URL": "https://img.4ye.run",
    "ALLOWED_WEB_ORIGIN": "https://4ye.run",
    "MAX_ASSET_SIZE_BYTES": "15728640"
  }
}

// 使用 `wrangler secret put PUBLISH_TOKEN` 写入应用级发布令牌。
// 测试环境应使用独立的 D1、R2 与域名配置。
