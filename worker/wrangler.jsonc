{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "4ye-run-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.4ye.run",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "4yerun",
      "database_id": "e6686ffb-aa18-41f4-92a6-a1c413528e9b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "4ye-run"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "4001",
      "simple": {
        "limit": 3000,
        "period": 60
      }
    }
  ],
  "vars": {
    "ASSET_PUBLIC_BASE_URL": "https://img.4ye.run",
    "ALLOWED_WEB_ORIGIN": "https://4ye.run",
    "MAX_ASSET_SIZE_BYTES": "15728640"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
