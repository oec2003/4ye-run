# Web 浏览器请求只配置完整 API 前缀一次。默认同域代理。
NUXT_PUBLIC_API_BASE_URL=/api/v1

# Nuxt 服务端将 /api/v1/* 转发到 Worker 的完整前缀。
# 留空时仅启用只读的本地历史 fixture，便于 Web 开发。
WORKER_API_BASE_URL=http://127.0.0.1:8787/api/v1

# Worker secrets 通过 `wrangler secret put` 设置，不能写在此文件。
PUBLISH_TOKEN=replace-with-a-long-random-token
ASSET_PUBLIC_BASE_URL=https://img.4ye.run
ALLOWED_WEB_ORIGIN=https://4ye.run
